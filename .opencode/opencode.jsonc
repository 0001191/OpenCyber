{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {
    "tool": {
      "read": "allow",
      "write": "allow",
      "run": "allow",
      "web": "allow",
      "bash": "allow",
      "grep": "allow"
    },
    "agent": {
      "binary-analysis": "allow"
    }
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
  "agent": {
    "plan": {
      "permission": {
        "skill": {
          "*": "deny"
        }
      }
    },
    "build": {
      "permission": {
        "skill": {
          "*": "deny"
        }
      }
    }
  }
}
